    def afficher_plan_complet(self):
        """Affiche l'intégralité du PND structuré par zone"""
        print(f"\n=======================================================")
        print(f"   PLAN DE NETTOYAGE ET DÉSINFECTION - {self.nom_hotel}")
        print(f"=======================================================\n")

        for code_zone, zone_info in self.pnd_database.items():
            print(f"📍 ZONE : {zone_info['nom']} [{code_zone}]")
            print("-" * 60)
            for t in zone_info["taches"]:
                critique_tag = "[CRITIQUE - CCP]" if t["critique"] else "[STANDARD]"
                print(
                    f"  • ID: {t['id']} | {t['element']} {critique_tag}\n"
                    f"    Fréquence : {t['frequence']}\n"
                    f"    Produit   : {t['produit']}\n"
                    f"    Méthode   : {t['methode']}\n"
                )
            print()

    def enregistrer_nettoyage(self, id_tache, nom_agent, conforme=True, remarque=""):
        """Permet à un agent ou chef d'équipe de valider une tâche (Traçabilité HACCP)"""
        now = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")

        # Recherche de la tâche
        tache_trouvee = None
        for zone in self.pnd_database.values():
            for t in zone["taches"]:
                if t["id"] == id_tache:
                    tache_trouvee = t
                    break

        if not tache_trouvee:
            print(f"❌ Erreur : La tâche {id_tache} n'existe pas dans le PND.")
            return

        enregistrement = {
            "horodatage": now,
            "id_tache": id_tache,
            "element": tache_trouvee["element"],
            "agent": nom_agent,
            "status": "CONFORME" if conforme else "NON-CONFORME",
            "remarque": remarque,
            "est_critique": tache_trouvee["critique"],
        }

        self.historique_enregistrements.append(enregistrement)

        print(
            f"✅ Enregistrement effectué à {now} pour '{tache_trouvee['element']}' par {nom_agent}."
        )
        if not conforme:
            print(
                f"⚠️ ALERTE NON-CONFORMITÉ : Une action corrective doit être menée immédiatement !"
            )

    def exporter_registre_json(self, filename="registre_pnd_cuisine.json"):
        """Exporte l'historique sous format JSON pour archivage / inspection sanitaire"""
        with open(filename, "w", encoding="utf-8") as f:
            json.dump(self.historique_enregistrements, f, ensure_ascii=False, indent=4)
        print(f"📁 Registre d'audit exporté avec succès sous '{filename}'.")


